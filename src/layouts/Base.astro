---
import { Font } from 'astro:assets';
import { SITE } from '../site';
import { at } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Share image path, e.g. /og/kings-avenue.jpg */
  image?: string;
  /** Tells the wall script which view to open first: "", "project:<id>" or "panel:<id>". */
  start?: string;
}
const { title, description = SITE.description, image = at('/og/home.jpg'), start = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{!SITE.live && <meta name="robots" content="noindex">}
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#121211">
<meta name="color-scheme" content="dark">
<script is:inline>
  // light or dark, before anything paints: the device's setting, unless the visitor has picked
  // the other one with the button in the top bar (kept in this browser)
  try {
    var mode = null;
    try { mode = localStorage.getItem('vistaraa-mode'); } catch (e) {}
    if (mode !== 'light' && mode !== 'dark') mode = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    if (mode === 'light') {
      document.documentElement.dataset.theme = 'light';
      document.querySelector('meta[name="theme-color"]').content = '#f1eee8';
      document.querySelector('meta[name="color-scheme"]').content = 'light';
    }
  } catch (e) {}
</script>
<link rel="icon" href={at('/favicon.svg')} type="image/svg+xml">
<link rel="apple-touch-icon" href={at('/apple-touch-icon.png')}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(image, SITE.url).href}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<Font cssVariable="--font-sans" preload />
<noscript><style>html .loader, html .theme, html .itog { display: none; } html .brand.is-wait svg { opacity: 1; }</style></noscript>
<slot name="head" />
</head>
<body data-start={start}>
<slot />
</body>
</html>
